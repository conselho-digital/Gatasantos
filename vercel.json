{
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.gatasantos.com.br" }], "destination": "https://gatasantos.com.br/$1", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(models|anims|hud|faces|loading|sounds)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}
