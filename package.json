{
  "name": "gata-santos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "size": "node scripts/size-report.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run lint && npm run typecheck && npm run build && npm run size && npm run check:secrets && npm run audit:prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
